# Forms post to /api/lead, which emails each enquiry through Brevo.
# Set these in Vercel (Project > Settings > Environment Variables).
BREVO_API_KEY=your-brevo-api-key
LEAD_TO=hello@nebulyx.live
LEAD_FROM=hello@nebulyx.live

# Optional: send forms to another JSON endpoint instead of /api/lead.
# VITE_FORM_ENDPOINT=https://formspree.io/f/your-form-id
